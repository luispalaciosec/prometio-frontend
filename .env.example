VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Producción (Vercel): URL pública del backend, sin barra final.
# En local dejalo vacío: el cliente usa /api-backend y Vite proxea con DEV_API_PROXY_TARGET.
VITE_API_URL=
# Solo `npm run dev`. Destino del proxy /api-backend.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
# Opcional. Bind del dev server.
DEV_SERVER_HOST=127.0.0.1
DEV_SERVER_PORT=5173
