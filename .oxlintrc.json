{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Regla del React Compiler, nueva en oxlint 1.92. Este proyecto no usa el compilador (React 18) y marca el patrón
    // estándar de sus pantallas: vaciar la lista antes de recargar y reiniciar un diálogo al abrirlo (~67 sitios en ~50
    // archivos). Corregirlo bien es reestructurar cada pantalla (reset por `key`, estado derivado): queda para la pasada
    // de calidad. Las demás reglas del compilador (purity, refs, preserve-manual-memoization) siguen activas.
    "react/set-state-in-effect": "off"
  }
}
